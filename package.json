{
  "name": "pyme-verde",
  "version": "1.0.0",
  "description": "PyME Verde: plataforma web para registrar, medir y dar seguimiento a las prácticas sustentables de una pequeña empresa.",
  "main": "src/server.js",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:local": "node scripts/local-db.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/seed.js --force",
    "test": "node --test --test-concurrency=1 tests/"
  },
  "author": "Oscar y Gonzalo Josue",
  "license": "MIT",
  "devDependencies": {
    "embedded-postgres": "^18.6.0-beta.19",
    "supertest": "^7.3.2"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.10",
    "ejs": "^7.0.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1"
  }
}
