# Copia este archivo como .env y ajusta los valores.
NODE_ENV=development
PORT=3000

# Cadena de conexión PostgreSQL. En local la crea `npm run db:local`.
# En producción (Neon) usa la cadena que te da el panel, con sslmode=require.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/pyme_verde

# Secreto para firmar la cookie de sesión. En producción usa una cadena larga y aleatoria.
SESSION_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Contraseñas de las cuentas de prueba que crea `npm run db:seed`.
# Si se dejan vacías, el seed genera contraseñas aleatorias y las muestra una sola vez en consola.
SEED_ADMIN_PASSWORD=
SEED_COLABORADOR_PASSWORD=
