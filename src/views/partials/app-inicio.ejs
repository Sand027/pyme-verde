<%#
  Armazón del panel privado: cabecera, barra lateral según permisos y encabezado de la página.
  Variables: titulo, intro (opcional), acciones (HTML opcional a la derecha del título), seccion (para el menú).
%>
<!doctype html>
<html lang="es-MX" data-type="software" data-radius="soft" data-buttons="pill" data-motion class="app-html">
<head>
<%- include('kit-head', { titulo: `${titulo} · PyME Verde` }) %>
<meta name="robots" content="noindex">
<meta name="csrf-token" content="<%= csrfToken %>">
<link rel="stylesheet" href="/css/app.css">
</head>
<body class="ap">
<a class="skip-link" href="#contenido">Saltar al contenido</a>
<%
  const ICONOS = {
    tablero: 'M3 3h6v8H3zM11 3h6v4h-6zM11 9h6v8h-6zM3 13h6v4H3z',
    registros: 'M4 3h12v14H4zM7 7h6M7 10h6M7 13h4',
    residuos: 'M4 6h12M8 6V4h4v2M5 6l1 11h8l1-11',
    calculadora: 'M5 2h10v16H5zM7 5h6v3H7zM7 11h1M10 11h1M13 11h0M7 14h1M10 14h1',
    acciones: 'M4 5l2 2 3-3M11 6h6M4 11l2 2 3-3M11 12h6',
    reportes: 'M4 17V9M9 17V4M14 17v-6',
    usuarios: 'M10 9a3 3 0 100-6 3 3 0 000 6zM4 17c0-3 3-5 6-5s6 2 6 5',
    configuracion: 'M10 12.5a2.5 2.5 0 100-5 2.5 2.5 0 000 5zM10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M4.3 15.7l1.4-1.4M14.3 5.7l1.4-1.4',
    bitacora: 'M10 4v6l4 2M10 18a8 8 0 100-16 8 8 0 000 16z',
    perfil: 'M10 9a3 3 0 100-6 3 3 0 000 6zM4 17c0-3 3-5 6-5s6 2 6 5',
  };
  const MENU = [
    { grupo: 'Taller', items: [
      { id: 'tablero', href: '/panel', texto: 'Tablero', permiso: P.PANEL_VER },
      { id: 'registros', href: '/panel/registros', texto: 'Registros', permiso: P.REGISTROS_LEER },
      { id: 'residuos', href: '/panel/residuos', texto: 'Residuos', permiso: P.REGISTROS_LEER },
      { id: 'calculadora', href: '/panel/calculadora', texto: 'Calculadora', permiso: P.PANEL_VER },
      { id: 'acciones', href: '/panel/acciones', texto: 'Plan de acciones', permiso: P.ACCIONES_LEER },
      { id: 'reportes', href: '/panel/reportes', texto: 'Reportes', permiso: P.REPORTES_GENERAR },
    ] },
    { grupo: 'Administración', items: [
      { id: 'usuarios', href: '/admin/usuarios', texto: 'Usuarios', permiso: P.USUARIOS_ADMINISTRAR },
      { id: 'configuracion', href: '/admin/configuracion', texto: 'Configuración', permiso: P.CONFIGURACION_ADMINISTRAR },
      { id: 'bitacora', href: '/admin/bitacora', texto: 'Bitácora', permiso: P.BITACORA_LEER },
    ] },
  ];
  const actual = locals.seccion || '';
%>
<div class="ap-shell">
  <aside class="ap-side" id="ap-menu" aria-label="Menú del panel">
    <div class="ap-side__top">
      <a class="nav__logo ap-logo" href="/panel"><span class="mark" data-mark="ring" aria-hidden="true"></span>PyME Verde</a>
      <button class="ap-side__close" type="button" data-menu-cerrar aria-label="Cerrar el menú">
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
    </div>
    <nav class="ap-nav">
      <% for (const g of MENU) { const visibles = g.items.filter((i) => puede(i.permiso)); if (!visibles.length) continue; %>
        <p class="ap-nav__grupo"><%= g.grupo %></p>
        <ul>
          <% for (const i of visibles) { %>
          <li><a class="ap-nav__link" href="<%= i.href %>" <%- actual === i.id ? 'aria-current="page"' : '' %>>
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="<%= ICONOS[i.id] %>" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span><%= i.texto %></span></a></li>
          <% } %>
        </ul>
      <% } %>
    </nav>
    <div class="ap-side__pie">
      <a class="ap-cuenta" href="/perfil" <%- actual === 'perfil' ? 'aria-current="page"' : '' %>>
        <span class="ap-avatar" aria-hidden="true"><%= usuario.nombre.split(' ').map((p) => p[0]).slice(0, 2).join('').toUpperCase() %></span>
        <span class="ap-cuenta__txt"><b><%= usuario.nombre %></b><small><%= usuario.rolEtiqueta %></small></span>
      </a>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--secondary btn--sm ap-salir" type="submit">Cerrar sesión</button>
      </form>
      <a class="ap-publico" href="/">Ver la página pública</a>
    </div>
  </aside>
  <div class="ap-velo" data-menu-cerrar hidden></div>
  <div class="ap-main">
    <header class="ap-top">
      <button class="ap-top__menu" type="button" data-menu-abrir aria-controls="ap-menu" aria-expanded="false" aria-label="Abrir el menú">
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
      <div class="ap-top__txt">
        <h1 class="ap-h1"><%= titulo %></h1>
        <% if (locals.intro) { %><p class="ap-intro"><%= intro %></p><% } %>
      </div>
      <% if (locals.accionesTop) { %><div class="ap-top__acc"><%- accionesTop %></div><% } %>
    </header>
    <div class="ap-avisos" data-avisos aria-live="polite">
      <% for (const m of (locals.flash || [])) { %>
        <p class="ap-aviso ap-aviso--<%= m.tipo %>" role="status"><%= m.texto %></p>
      <% } %>
      <% if (locals.avisoError) { %><p class="ap-aviso ap-aviso--error" role="alert"><%= avisoError %></p><% } %>
    </div>
    <main id="contenido" class="ap-contenido" tabindex="-1">
