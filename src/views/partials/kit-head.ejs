<%#
  Cabecera común de la sección pública (taste-skill): fuentes, hojas del kit en el orden que pide
  el sistema y la paleta repartida (flour-terracotta, tipografía host, radio soft).
  Variables: titulo, descripcion, momentos (lista de ids de momentos de la página), ui (lista de fragmentos).
%>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= titulo %></title>
<meta name="description" content="<%= locals.descripcion || 'PyME Verde registra los residuos, la energía y el agua de un taller de calzado de León y calcula sus indicadores de sustentabilidad cada mes.' %>">
<meta property="og:type" content="website">
<meta property="og:title" content="<%= titulo %>">
<meta property="og:description" content="<%= locals.descripcion || 'Indicadores ambientales, sociales y económicos de un taller de calzado, con su meta y su fórmula.' %>">
<meta property="og:image" content="/share.jpg">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<meta name="theme-color" content="#f6f1e7">
<meta name="site-kind" content="software">
<meta name="page-type" content="software">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Host+Grotesk:wght@400..700&family=JetBrains+Mono:wght@400..500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/system.css">
<link rel="stylesheet" href="/assets/ui/cards.css">
<link rel="stylesheet" href="/assets/motion/motion.css">
<link rel="stylesheet" href="/assets/backgrounds/backgrounds.css">
<link rel="stylesheet" href="/assets/layout/layout.css">
<link rel="stylesheet" href="/assets/icons/icon.css">
<style>
:root {
  --p-bg: #f6f1e7; --p-surface: #ebe3d4; --p-ink: #2b241e; --p-muted: #6a5f54;
  --p-accent: #a3472b; --p-accent-ink: #ffffff; --p-action: #a3472b; --p-action-ink: #ffffff;
  --p-inv-bg: #2b241e; --p-inv-surface: #37302a; --p-inv-ink: #f6f1e7; --p-inv-muted: #a29c94;
  --p-inv-accent: #f6f1e7; --p-inv-accent-ink: #2b241e; --p-inv-action: #f6f1e7; --p-inv-action-ink: #2b241e;
  --font-display: "Host Grotesk", system-ui, sans-serif;
  --font-text: "Host Grotesk", system-ui, sans-serif;
  --font-mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
  --display-weight: 500;
  --display-tracking: -0.035em;
  --display-tracking-xl: -0.04em;
}
</style>
<link rel="stylesheet" href="/assets/ui/base.css">
<% for (const frag of (locals.ui || [])) { %><link rel="stylesheet" href="/assets/ui/<%= frag %>/fragment.css">
<% } %>
<script nonce="<%= locals.cspNonce %>">document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
<script src="/assets/backgrounds/backgrounds.js"></script>
<% if ((locals.momentos || []).length) { %>
<script nonce="<%= locals.cspNonce %>">document.documentElement.classList.add('mo-js');setTimeout(()=>document.documentElement.classList.add('mo-safe'),2500)</script>
<link rel="modulepreload" href="/assets/moments/moments.js">
<link rel="modulepreload" href="/assets/moments/lib.js">
<% for (const m of momentos) { %><link rel="modulepreload" href="/assets/moments/<%= m %>/moment.js">
<% } %>
<% } %>
<link rel="stylesheet" href="/css/publico.css">
