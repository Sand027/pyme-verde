<%
  const porTipo = {};
  for (const c of categorias) (porTipo[c.tipo] ||= []).push(c);
  const hoy = new Date().toISOString().slice(0, 10);
  const acciones = (puede(P.REGISTROS_CREAR) ? '<button class="btn btn--primary btn--sm" type="button" data-nuevo>Nuevo registro</button>' : '')
    + (puede(P.REPORTES_GENERAR) ? '<a class="btn btn--secondary btn--sm" href="/api/reportes/registros.csv" data-csv>Exportar CSV</a>' : '');
%>
<%- include('../partials/app-inicio', {
  titulo: 'Registros', seccion: 'registros',
  intro: 'Consumos, materia prima, producción, residuos y horas de capacitación. Cada registro guarda su origen: lectura, recibo, báscula, inventario, estimación o demostración.',
  accionesTop: acciones,
}) %>

<section class="ap-caja ap-caja--suave" aria-labelledby="filtros-h">
  <h2 class="sr-only" id="filtros-h">Filtros</h2>
  <form class="ap-filtros" data-filtros role="search">
    <div class="field"><label for="f-desde">Desde</label><input id="f-desde" name="desde" type="date" max="<%= hoy %>"></div>
    <div class="field"><label for="f-hasta">Hasta</label><input id="f-hasta" name="hasta" type="date" max="<%= hoy %>"></div>
    <div class="field"><label for="f-tipo">Tipo</label>
      <select id="f-tipo" name="tipo"><option value="">Todos</option><% for (const [k, v] of Object.entries(tipos)) { %><option value="<%= k %>"><%= v %></option><% } %></select></div>
    <div class="field"><label for="f-cat">Concepto</label>
      <select id="f-cat" name="categoriaId"><option value="">Todos</option>
        <% for (const [t, lista] of Object.entries(porTipo)) { %><optgroup label="<%= tipos[t] %>"><% for (const c of lista) { %><option value="<%= c.id %>" data-tipo="<%= c.tipo %>"><%= c.nombre %></option><% } %></optgroup><% } %>
      </select></div>
    <div class="field"><label for="f-origen">Origen</label>
      <select id="f-origen" name="origen"><option value="">Todos</option><% for (const [k, v] of Object.entries(origenes)) { %><option value="<%= k %>"><%= v %></option><% } %></select></div>
    <div class="field"><label for="f-texto">Buscar en notas</label><input id="f-texto" name="texto" type="search" maxlength="80" placeholder="Palabra o frase"></div>
    <div class="field"><label for="f-orden">Orden</label>
      <select id="f-orden" name="orden"><option value="fecha_desc">Más recientes</option><option value="fecha_asc">Más antiguos</option><option value="cantidad_desc">Mayor cantidad</option><option value="costo_desc">Mayor costo</option><option value="categoria">Por concepto</option></select></div>
    <label class="field--check"><input type="checkbox" name="soloMios" value="true"> Solo mis registros</label>
    <div class="btn-row"><button class="btn btn--secondary btn--sm" type="reset">Limpiar</button></div>
  </form>
</section>

<section class="ap-caja" aria-labelledby="lista-h">
  <div class="ap-caja__cab">
    <h2 class="ap-h2" id="lista-h">Lista de registros</h2>
    <p class="ap-nota" data-total aria-live="polite"></p>
  </div>
  <div class="ap-tabla-envoltura">
    <table class="ap-tabla">
      <thead><tr>
        <th scope="col">Fecha</th><th scope="col">Concepto</th><th scope="col" class="num">Cantidad</th>
        <th scope="col" class="num ocultar-tel">Aprovechado</th><th scope="col" class="num ocultar-tel">Costo</th>
        <th scope="col" class="ocultar-tel">Origen</th><th scope="col" class="ocultar-tel">Capturó</th><th scope="col" class="acc"><span class="sr-only">Acciones</span></th>
      </tr></thead>
      <tbody data-filas><tr class="ap-tabla__vacia"><td colspan="8">Cargando…</td></tr></tbody>
    </table>
  </div>
  <div class="ap-paginas" style="margin-top: var(--s-4)">
    <span data-pagina-txt></span>
    <div class="ap-paginas__btns">
      <button class="btn btn--secondary btn--sm" type="button" data-pag="-1">Anterior</button>
      <button class="btn btn--secondary btn--sm" type="button" data-pag="1">Siguiente</button>
    </div>
  </div>
</section>

<div class="ap-fondo" data-fondo hidden></div>
<aside class="ap-panel" data-panel aria-labelledby="panel-h" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="ap-panel__cab">
    <h2 class="ap-h2" id="panel-h" data-panel-titulo>Nuevo registro</h2>
    <button class="ap-btn-txt" type="button" data-panel-cerrar>Cerrar</button>
  </div>
  <div class="ap-panel__cuerpo">
    <form class="form" data-form-registro novalidate>
      <input type="hidden" name="id">
      <div class="field field--full"><label for="r-cat">Concepto</label>
        <select id="r-cat" name="categoriaId" required data-error="Elige qué se registra.">
          <option value="">Elige un concepto</option>
          <% for (const [t, lista] of Object.entries(porTipo)) { %><optgroup label="<%= tipos[t] %>"><% for (const c of lista) { %><option value="<%= c.id %>" data-tipo="<%= c.tipo %>" data-unidad="<%= c.unidad %>"><%= c.nombre %> (<%= c.unidad %>)</option><% } %></optgroup><% } %>
        </select></div>
      <div class="field"><label for="r-fecha">Fecha</label><input id="r-fecha" name="fecha" type="date" required max="<%= hoy %>" min="2015-01-01" data-error="Indica una fecha que no sea futura."></div>
      <div class="field"><label for="r-cant">Cantidad <span class="ap-ayuda" data-unidad></span></label><input id="r-cant" name="cantidad" type="number" step="any" min="0.001" required inputmode="decimal" data-error="Escribe una cantidad mayor que cero."></div>
      <div class="field"><label for="r-costo">Costo en pesos <span class="ap-ayuda">opcional</span></label><input id="r-costo" name="costo" type="number" step="0.01" min="0" inputmode="decimal"></div>
      <div class="field"><label for="r-origen">Origen del dato</label>
        <select id="r-origen" name="origenDato" required data-error="Indica de dónde sale el dato.">
          <option value="">Elige el origen</option>
          <% for (const [k, v] of Object.entries(origenes)) { %><option value="<%= k %>"><%= v %></option><% } %>
        </select></div>
      <fieldset class="field--full ap-solo-residuo form" data-residuo hidden>
        <legend class="ap-h3" style="margin-bottom: var(--s-3)">Destino del residuo</legend>
        <div class="field"><label for="r-aprov">Cantidad aprovechada</label><input id="r-aprov" name="cantidadAprovechada" type="number" step="any" min="0" inputmode="decimal" value="0"></div>
        <div class="field"><label for="r-destino">Destino</label><select id="r-destino" name="destino"><option value="">Elige el destino</option></select></div>
        <div class="field field--full"><label for="r-evid">Evidencia del destino <span class="ap-ayuda" data-evid-ayuda>número de manifiesto, nota o constancia</span></label><input id="r-evid" name="evidenciaDestino" type="text" maxlength="200"></div>
        <p class="ap-nota field--full" data-recomendacion></p>
      </fieldset>
      <div class="field field--full"><label for="r-notas">Notas <span class="ap-ayuda">opcional, hasta 500 caracteres</span></label><textarea id="r-notas" name="notas" maxlength="500" rows="3"></textarea></div>
      <div class="btn-row"><button class="btn btn--primary" type="submit" data-guardar>Guardar registro</button><button class="btn btn--secondary" type="button" data-panel-cerrar>Cancelar</button></div>
      <p class="form__status" data-estado-form role="status"></p>
    </form>
  </div>
</aside>

<%- include('../partials/app-fin', { scripts: ['registros.js'] }) %>
